# Root of the split repo. Each project (conductor/, cowork-suite/) has its
# own .gitignore covering secrets and runtime data. This one only guards
# against accidental builds or IDE files at the root.

# Secrets — belt and braces; never commit a key anywhere in this tree.
config.properties
*.key
.env

# Build output
target/
bin/
*.class

# IDE
.idea/
*.iml
.classpath
.project
.settings/
.vscode/

# OS
.DS_Store
Thumbs.db
