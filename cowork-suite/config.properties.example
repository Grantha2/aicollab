# Cowork Suite configuration
#
# Copy this file to config.properties (same folder) and fill in your key.
# config.properties is gitignored - never commit it.
#
# The suite reads config.properties and writes all of its data files in its
# home directory, resolved in this order:
#   1. JVM system property  -Dcowork.home=/path/to/dir
#   2. environment variable COWORK_HOME
#   3. the current working directory
# Assets (PDF form, fixtures) are expected under <home>/assets/.

# --- Claude (required) --------------------------------------------------------
# Create a key at https://console.anthropic.com/settings/keys
claude.key=YOUR_ANTHROPIC_KEY_HERE

# Model id. Default: claude-opus-5
#claude.model=claude-opus-5

# Messages API endpoint. Change only when routing through a proxy or gateway.
#claude.url=https://api.anthropic.com/v1/messages

# Maximum tokens Claude may return per call. Default: 16000
#max.response.tokens=16000

# --- Room reservation workflow (optional) -------------------------------------
# Computer-use sandbox that drives a browser for live availability lookups.
#computer.use.sandbox.url=http://localhost:9000/v1/computer-use

# fixture = read assets/fixtures/room_availability.html (offline demo)
# live    = query the sandbox above
#room.availability.mode=fixture

# Directory where filled reservation PDFs are written.
#pdf.output.dir=~/cowork-filled
